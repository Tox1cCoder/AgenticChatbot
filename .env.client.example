# Local client backend environment example.
# Copy to .env.client and adjust local paths as needed.
# The authoritative schema is client_backend/core/config.py::ClientSettings.

# Canonical server backend
CLIENT_SERVER_API_BASE_URL=http://localhost:8000
CLIENT_SERVER_API_TIMEOUT_SECONDS=60

# Local client backend bind
CLIENT_BACKEND_HOST=127.0.0.1
CLIENT_BACKEND_PORT=8100
CLIENT_ENVIRONMENT=development

# Local profile and identity
# Windows default if omitted: %LOCALAPPDATA%\CodexDesktop
CLIENT_PROFILE_ROOT=
CLIENT_DEVICE_NAME=

# Local runtime configuration
# Comma-separated absolute paths for optional local skill scanning.
CLIENT_SKILLS_ROOTS=
# Comma-separated absolute paths that client-side filesystem tools may access.
CLIENT_WORKSPACE_ROOTS=
CLIENT_TOOL_CALL_TIMEOUT_SECONDS=60

# MCP
# Optional explicit MCP config path. If omitted, the client stores per-user
# MCP config under the local profile directory.
CLIENT_MCP_CONFIG_PATH=
CLIENT_MCP_STARTUP_TIMEOUT_SECONDS=30

# Runtime bridge
CLIENT_HEARTBEAT_INTERVAL_SECONDS=30
CLIENT_RECONNECT_DELAY_SECONDS=5
CLIENT_MAX_RECONNECT_ATTEMPTS=10

# Local session security
# Leave blank to auto-generate a persisted secret under CLIENT_PROFILE_ROOT.
CLIENT_LOCAL_SESSION_SECRET=
CLIENT_LOCAL_SESSION_EXPIRE_MINUTES=1440

# Logging
CLIENT_LOG_LEVEL=INFO
CLIENT_LOG_TO_FILE=true
