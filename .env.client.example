# Canonical server backend
CLIENT_SERVER_API_BASE_URL=http://localhost:8000
CLIENT_SERVER_API_TIMEOUT_SECONDS=60

# Local client backend bind
CLIENT_BACKEND_HOST=127.0.0.1
CLIENT_BACKEND_PORT=8100
CLIENT_ENVIRONMENT=production

# Local profile and identity
# Windows default if omitted: %LOCALAPPDATA%\CodexDesktop
CLIENT_PROFILE_ROOT=
CLIENT_DEVICE_NAME=

# Local tool configuration
# Comma-separated absolute paths for optional local skill scanning
CLIENT_SKILLS_ROOTS=

# Optional explicit MCP config path. If omitted, the client stores per-user
# MCP config under the local profile directory.
CLIENT_MCP_CONFIG_PATH=

# Shell policy
CLIENT_ALLOWED_SHELLS=powershell,cmd,bash,sh
CLIENT_SHELL_TIMEOUT_SECONDS=60
CLIENT_SHELL_MAX_OUTPUT_BYTES=1048576

# Runtime bridge
CLIENT_HEARTBEAT_INTERVAL_SECONDS=30
CLIENT_RECONNECT_DELAY_SECONDS=5
CLIENT_MAX_RECONNECT_ATTEMPTS=10

# Logging
CLIENT_LOG_LEVEL=INFO
CLIENT_LOG_TO_FILE=true
