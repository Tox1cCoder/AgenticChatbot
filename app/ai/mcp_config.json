      },
      "enabled": true
    },
    "desktop-commander": {
      "transport": "stdio",
      "command": "node",
      "args": [
        "C:\\Users\\Vina32\\AppData\\Roaming\\npm\\node_modules\\@wonderwhy-er\\desktop-commander\\dist\\index.js"
      ],
      "env": {
        "NODE_OPTIONS": "--no-warnings"
