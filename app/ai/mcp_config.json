{
  "mcp_servers": {
    "calculator": {
      "enabled": true,
      "transport": "stdio",
      "command": "python",
      "args": [
        "app/ai/mcp_servers/calculator_server.py"
      ],
      "description": "Basic calculator operations (add, subtract, multiply, divide, power)"
    },
    "tavily": {
      "enabled": true,
      "transport": "stdio",
      "command": "python",
      "args": [
        "app/ai/mcp_servers/tavily_server.py"
      ],
      "description": "Web search using Tavily API for real-time information retrieval"
    },
    "time": {
      "enabled": true,
      "transport": "stdio",
      "command": "python",
      "args": [
        "app/ai/mcp_servers/time_server.py"
      ],
      "description": "Current time lookup utility with timezone support"
    },
    "boring": {
      "enabled": false,
      "transport": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "conda",
        "run",
        "-n",
        "chatbot",
        "--no-capture-output",
        "python",
        "app/ai/mcp_servers/boring_servers/boring_reader_server.py"
      ],
      "description": "Borehole PDF data extractor - extracts structured borehole log data from PDF files"
    },
    "desktop-commander": {
      "transport": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@smithery/cli@latest",
        "run",
        "@wonderwhy-er/desktop-commander",
        "--key",
        "83ba8c64-cf9d-4033-ab36-91366e89f9c8"
      ],
      "enabled": true
    }
  }
}