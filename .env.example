# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/chatbot

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Environment
ENVIRONMENT=development

# Security
SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# LLM API Keys
GEMINI_API_KEY="your_gemini_api"

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents

# Redis Configuration (for Celery)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# File Storage Configuration
TEMP_STORAGE_PATH=app/temp
MAX_FILE_SIZE_MB=50

# Document Processing Configuration
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200

# RAG Retrieval Configuration
RAG_TOP_K=15
RAG_SCORE_THRESHOLD=0.2
RAG_MAX_CONTEXT_TOKENS=30000

# Re-ranking Configuration
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=10

# Advanced Chunking Configuration
CHUNK_BY_SENTENCES=true
PRESERVE_CROSS_PAGE_CONTEXT=true

# RAG Prompt Configuration
RAG_CHUNKS_IN_PROMPT=10
MAX_CHUNK_CHARS_IN_PROMPT=2000

# LangGraph Checkpoint Configuration
ENABLE_LANGGRAPH_CHECKPOINTS=true
CHECKPOINT_SCHEMA=public