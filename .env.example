# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/chatbot

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Environment
ENVIRONMENT=development

# Security
SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# LLM API Keys
GEMINI_API_KEY="your_gemini_api"

# LangSmith Configuration (Tracing & Observability)
LANGSMITH_API_KEY="your_langsmith_api_key"
LANGSMITH_PROJECT="sample-chatbot"
LANGSMITH_TRACING=false

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents_gemini_embedding_2_3072
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSION=3072
RAG_EMBEDDING_QUERY_TASK=search result

# Redis Configuration
# Recommended local setup: `docker compose -f docker-compose.redis.yml up -d redis`
# The bundled Docker setup enables Redis auth by default.
REDIS_PASSWORD=sample-chatbot-dev
REDIS_URL=redis://:sample-chatbot-dev@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://:sample-chatbot-dev@127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://:sample-chatbot-dev@127.0.0.1:6379/0

# File Storage Configuration
TEMP_STORAGE_PATH=app/temp
MAX_FILE_SIZE_MB=50

# Document Processing Configuration
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200
MINERU_TIMEOUT=300
MINERU_API_URL=
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_LANG=
EXTRACT_FORMULAS_FROM_PDF=true
EXTRACT_TABLES_FROM_PDF=true
MINERU_EXTRA_ARGS=[]

# MinerU upstream tuning (consumed by the mineru subprocess)
# MINERU_MODEL_SOURCE=huggingface
# MINERU_PROCESSING_WINDOW_SIZE=64
# MINERU_INTRA_OP_NUM_THREADS=-1
# MINERU_INTER_OP_NUM_THREADS=-1
# MINERU_API_MAX_CONCURRENT_REQUESTS=3

# RAG Retrieval Configuration
RAG_TOP_K=15
RAG_SCORE_THRESHOLD=0.2
RAG_MAX_CONTEXT_TOKENS=30000

# Re-ranking Configuration
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=10

# Advanced Chunking Configuration
CHUNK_BY_SENTENCES=true
PRESERVE_CROSS_PAGE_CONTEXT=true

# RAG Prompt Configuration
RAG_CHUNKS_IN_PROMPT=10
MAX_CHUNK_CHARS_IN_PROMPT=2000

# LangGraph Checkpoint Configuration
ENABLE_LANGGRAPH_CHECKPOINTS=true
CHECKPOINT_SCHEMA=public

# Gemini Thinking/Reasoning Configuration
ENABLE_THINKING=true
THINKING_LEVEL=medium
INCLUDE_THOUGHTS_IN_RESPONSE=true

# ── Conversation Memory & History Budgets ──────────────────────────
# MEMORY_MAX_MESSAGES=0               # Max messages cached per conversation (0 = unlimited)
# MEMORY_LOAD_BATCH_SIZE=200          # DB fetch batch size for memory hydration

# CHAT_HISTORY_MAX_MESSAGES=24        # Chat prompt history cap (messages)
# CHAT_HISTORY_MAX_TOKENS=9000        # Chat prompt history cap (tokens)

# RAG_HISTORY_MAX_MESSAGES=12         # RAG prompt history cap (messages)
# RAG_HISTORY_MAX_TOKENS=3000         # RAG prompt history cap (tokens)

# SEARCH_HISTORY_MAX_MESSAGES=16      # Search prompt history cap (messages)
# SEARCH_HISTORY_MAX_TOKENS=5000      # Search prompt history cap (tokens)

# PLANNING_HISTORY_MAX_MESSAGES=16    # Planning prompt history cap (messages)
# PLANNING_HISTORY_MAX_TOKENS=5000    # Planning prompt history cap (tokens)

# ── Summarization Middleware ───────────────────────────────────────
# ENABLE_SUMMARIZATION=true
# SUMMARIZATION_TRIGGER_TOKENS=18000          # Token threshold to trigger summarization
# SUMMARIZATION_TRIGGER_MESSAGES=60           # Message count threshold
# SUMMARIZATION_TRIGGER_FRACTION=0.55         # Context-window fraction threshold
# SUMMARIZATION_MODEL_CONTEXT_SIZE=128000     # Cross-provider practical baseline
# SUMMARIZATION_KEEP_MESSAGES=8               # Messages preserved after summarizing
# SUMMARIZATION_MODEL=gemini-3-flash-preview  # Model used for summarization
# SUMMARIZATION_MAX_SUMMARY_TOKENS=1500       # Hard cap on summary size in tokens (0 = unlimited)

# ── Tool Result Truncation ─────────────────────────────────────────
# TOOL_RESULT_MAX_CHARS=16000         # Max chars per tool result sent to model (0 = no limit)
