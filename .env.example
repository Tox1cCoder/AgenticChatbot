# Server backend environment example.
# Copy to .env and fill in secrets for your environment.
# The authoritative schema is app/core/config.py::Settings.

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/chatbot

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
ENVIRONMENT=development
RUNTIME_TIME_CONTEXT_TIMEZONE=UTC

# Security
# Leave blank in development to use an ephemeral local key. Set a stable strong
# value in staging/production.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=600
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Providers and model keys
GEMINI_API_KEY=
TAVILY_API_KEY=
TAVILY_SEARCH_DEFAULT_MAX_RESULTS=5
TAVILY_SEARCH_MAX_RESULTS=10
TAVILY_SEARCH_DEFAULT_DEPTH=basic
TAVILY_SEARCH_INCLUDE_IMAGES=true
TAVILY_SEARCH_INCLUDE_IMAGE_DESCRIPTIONS=true
TAVILY_SEARCH_AUTO_PARAMETERS=false
TAVILY_EXTRACT_MAX_URLS=5
TAVILY_EXTRACT_DEFAULT_DEPTH=basic
TAVILY_EXTRACT_DEFAULT_FORMAT=markdown
TAVILY_EXTRACT_TIMEOUT_SECONDS=20
TAVILY_MAP_MAX_DEPTH=2
TAVILY_MAP_MAX_BREADTH=20
TAVILY_MAP_LIMIT=50
TAVILY_MAP_TIMEOUT_SECONDS=30
TAVILY_CRAWL_MAX_DEPTH=1
TAVILY_CRAWL_MAX_BREADTH=10
TAVILY_CRAWL_LIMIT=20
TAVILY_CRAWL_TIMEOUT_SECONDS=45
SMITHERY_API_KEY=
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_ENCRYPTION_KEY=
OPENAI_REQUEST_TIMEOUT_SECONDS=60
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_DELAY_SECONDS=1.0

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sample-chatbot
LANGSMITH_TRACING=false

# Agent models
RAG_AGENT_MODEL=gemini-3.1-pro-preview
CHAT_AGENT_MODEL=gemini-3-flash-preview
SEARCH_AGENT_MODEL=gemini-3-flash-preview

# Gemini media, thinking, and image generation
MEDIA_RESOLUTION=high
ENABLE_GEMINI_CODE_EXECUTION=true
ENABLE_IMAGE_GENERATION=true
IMAGE_GENERATOR_MODEL=gemini-3-pro-image-preview
IMAGE_GENERATOR_DEFAULT_ASPECT_RATIO=1:1
IMAGE_GENERATOR_MAX_IMAGES=1
IMAGE_CAPTION_MODEL=gemini-3-flash-preview
IMAGE_CAPTION_MAX_RETRY_ATTEMPTS=5
IMAGE_CAPTION_RETRY_DELAY_SECONDS=5.0
IMAGE_CAPTION_MAX_CONCURRENCY=4
ENABLE_THINKING=true
THINKING_LEVEL=high
THINKING_BUDGET=-1
INCLUDE_THOUGHTS_IN_RESPONSE=true

# Qdrant vector database and RAG retrieval
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents_gemini_embedding_2_3072
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIMENSION=3072
RAG_EMBEDDING_QUERY_TASK="search result"
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_MAX_CONCURRENCY=4
RAG_MULTIMODAL_IMAGE_EMBEDDINGS_ENABLED=false
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_CHUNK_TARGET_TOKENS=400
RAG_CHUNK_OVERLAP_TOKENS=40
RAG_CHUNK_MAX_TOKENS=800
RAG_TOP_K=15
RAG_SCORE_THRESHOLD=0.2
ENABLE_RERANKING=true
RERANK_TOP_K=10
QDRANT_UPSERT_BATCH_SIZE=1000

# Redis
# Recommended local setup: docker compose -f docker-compose.redis.yml up -d redis
# The bundled Docker setup enables Redis auth by default.
REDIS_PASSWORD=sample-chatbot-dev
REDIS_URL=redis://:sample-chatbot-dev@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://:sample-chatbot-dev@127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://:sample-chatbot-dev@127.0.0.1:6379/0

# Celery workers
# Windows local development: auto resolves to threads for real concurrency.
# Linux production: auto resolves to prefork. Use solo only for debugging.
CELERY_WORKER_POOL=auto
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=10
CELERY_WORKER_TIME_LIMIT=300
CELERY_WORKER_SOFT_TIME_LIMIT=240
CELERY_WORKER_CANCEL_LONG_RUNNING_TASKS_ON_CONNECTION_LOSS=true
CELERY_BROKER_HEALTH_CHECK_INTERVAL=30
CELERY_BROKER_VISIBILITY_TIMEOUT=3600
CELERY_BROKER_SOCKET_KEEPALIVE=true
CELERY_BROKER_RETRY_ON_TIMEOUT=true
CELERY_INDEX_TIME_LIMIT=600
CELERY_PARSE_CONCURRENCY=2
CELERY_INDEX_CONCURRENCY=8

# File storage and document processing
TEMP_STORAGE_PATH=app/temp
MAX_FILE_SIZE_MB=50
DOCUMENT_IMAGES_STORAGE_PATH=app/storage/document_images
PARSE_ARTIFACTS_STORAGE_PATH=app/storage/parse_artifacts
MINERU_TIMEOUT=300
MINERU_API_URL=
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_LANG=
MINERU_EXTRA_ARGS=[]
EXTRACT_FORMULAS_FROM_PDF=true
EXTRACT_TABLES_FROM_PDF=true
TABLE_FORMAT=markdown

# Conversation memory and history budgets
MEMORY_MAX_MESSAGES=0
MEMORY_LOAD_BATCH_SIZE=100
MEMORY_CACHE_TTL_SECONDS=60
MEMORY_CACHE_MAX_CONVERSATIONS=256
MEMORY_SUMMARY_MIN_UNSUMMARIZED_MESSAGES=60
MEMORY_SUMMARY_MIN_UNSUMMARIZED_TOKENS=18000
MEMORY_SUMMARY_KEEP_MESSAGES=8
MEMORY_SUMMARY_MAX_TOKENS=1500
MEMORY_SUMMARY_TIMEOUT_SECONDS=30
CHAT_HISTORY_MAX_MESSAGES=24
CHAT_HISTORY_MAX_TOKENS=9000
RAG_HISTORY_MAX_MESSAGES=12
RAG_HISTORY_MAX_TOKENS=3000
SEARCH_HISTORY_MAX_MESSAGES=16
SEARCH_HISTORY_MAX_TOKENS=5000
PLANNING_HISTORY_MAX_MESSAGES=16
PLANNING_HISTORY_MAX_TOKENS=5000

# Summarization
ENABLE_SUMMARIZATION=true
SUMMARIZATION_TRIGGER_TOKENS=18000
SUMMARIZATION_TRIGGER_MESSAGES=60
SUMMARIZATION_TRIGGER_FRACTION=0.55
SUMMARIZATION_MODEL_CONTEXT_SIZE=128000
SUMMARIZATION_KEEP_MESSAGES=8
SUMMARIZATION_MODEL=gemini-3-flash-preview
SUMMARIZATION_MAX_SUMMARY_TOKENS=1500
SUMMARIZATION_TIMEOUT_SECONDS=30
SUPPRESS_INTERNAL_STREAM_CHUNKS=true

# Agent loop, planning, and tool execution
REACT_AGENT_MAX_ITERATIONS=50
MAX_HANDOFF_DELEGATION_DEPTH=5
REACT_AGENT_QUALITY_THRESHOLD=0.7
REACT_AGENT_RECURSION_LIMIT=105
TOOL_CHOICE_MODE=auto
MAX_AUTO_PLAN_TASKS=20
EXECUTION_CALL_BUDGET=20
PLANNING_MAX_ITERATIONS=0
PLANNING_CONSECUTIVE_ERRORS_LIMIT=3
PLANNING_RUBRIC_ENABLED=true
PLANNING_RUBRIC_MAX_ITERATIONS=3
PLANNING_SUBAGENTS_ENABLED=true
AGENTIC_MAX_ITERATIONS=10
AGENTIC_PREVIEW_CHARS=1500
AUTO_CONTINUE_ENABLED=true
AUTO_CONTINUE_MAX_ROUNDS=5
AUTO_CONTINUE_SOFT_LIMIT_RATIO=0.8
AUTO_CONTINUE_EMIT_EVENTS=false
AUTO_CONTINUE_MAX_TOTAL_ITERATIONS=200
AUTO_CONTINUE_TIMEOUT_SECONDS=300
TOOL_EXECUTION_TIMEOUT=30
TOOL_EXECUTION_MAX_RETRIES=2
TOOL_VALIDATION_ENABLED=true

# Tool result handling and context-overflow retry
TOOL_RESULT_MAX_CHARS=16000
TOOL_RESULT_OFFLOAD_ENABLED=true
TOOL_RESULT_OFFLOAD_THRESHOLD_CHARS=16000
TOOL_RESULT_OFFLOAD_PREVIEW_CHARS=4000
CONTEXT_OVERFLOW_RETRY_ENABLED=true
CONTEXT_OVERFLOW_RETRY_TOOL_PREVIEW_CHARS=4000

# User memory tools
ENABLE_USER_MEMORY_TOOLS=false
USER_MEMORY_MAX_PROMPT_ITEMS=20

# Per-agent tool allowlists. Empty lists bind all available tools.
CHAT_AGENT_ALLOWED_TOOLS=[]
SEARCH_AGENT_ALLOWED_TOOLS=[]
RAG_AGENT_ALLOWED_TOOLS=[]
PLANNING_AGENT_ALLOWED_TOOLS=[]

# Safety and citation controls
CONFIDENCE_THRESHOLD_ABSTAIN=0.3
ENABLE_STRUCTURED_OUTPUT_VALIDATION=false
CONFIDENCE_WEIGHT_TOOL_SUCCESS=0.4
CONFIDENCE_WEIGHT_COMPLETENESS=0.3
CONFIDENCE_WEIGHT_RETRIEVAL=0.3
ENABLE_CITATION_VERIFICATION=true
MIN_CITATION_COVERAGE=0.5

# LangGraph checkpoints
ENABLE_LANGGRAPH_CHECKPOINTS=true
CHECKPOINT_SCHEMA=public

# Human-in-the-loop
ENABLE_HUMAN_IN_THE_LOOP=true
HITL_TOOLS_REQUIRE_APPROVAL=[]
HITL_APPROVAL_TIMEOUT_MINUTES=30

# MCP deferred tool search
MCP_TOOL_SEARCH_ENABLED=true
MCP_TOOL_SEARCH_DEFAULT_TOP_K=3
MCP_TOOL_SEARCH_MAX_TOP_K=100
MCP_TOOL_SEARCH_DESCRIPTION_MAX_CHARS=120
MCP_TOOL_SEARCH_MATCH_REASONS_MAX=2
MCP_TOOL_SEARCH_DEBUG_SCORES=false
MCP_TOOL_SEARCH_AUTOLOAD_TOP_K=1
MCP_TOOL_SEARCH_INVENTORY_DEFAULT_TOP_K=20
MCP_TOOL_SEARCH_INVENTORY_MAX_TOP_K=50
MCP_TOOL_SEARCH_PINNED_TOOLS=[]
MCP_TOOL_SEARCH_MAX_PINNED_TOOLS=5
MCP_TOOL_SEARCH_MAX_LOADED_TOOLS_PER_CONVERSATION=8
MCP_TOOL_SEARCH_LOADED_TOOLS_TTL_MINUTES=30
MCP_TOOL_SEARCH_MIN_RELEVANCE_SCORE=0.5
MCP_TOOL_SEARCH_AUTOLOAD_MIN_RELEVANCE_SCORE=2.0
MCP_TOOL_SEARCH_LOG_QUERIES=false

# Client runtime bridge
ENABLE_CLIENT_RUNTIME_BRIDGE=true
CLIENT_RUNTIME_WS_TIMEOUT_SECONDS=60
CLIENT_RUNTIME_CATALOG_CACHE_TTL_SECONDS=300
CLIENT_RUNTIME_REQUIRE_CONNECTED_DEVICE_FOR_LOCAL_TOOLS=true
CLIENT_RUNTIME_HEARTBEAT_INTERVAL_SECONDS=30
CLIENT_RUNTIME_MAX_TOOL_RESULT_SIZE_BYTES=1048576

# Inline rich responses
INLINE_RICH_RESPONSE_ENABLED=true
RICH_ITEM_INVENTORY_MAX_ITEMS=12
RICH_ITEM_INVENTORY_MAX_CHARS=2400
RICH_ITEM_SUMMARY_MAX_CHARS=180
RICH_ITEM_SELECTED_IMAGE_MAX_BYTES=10485760
RICH_AUTO_PLACE_ENABLED=true
RICH_AUTO_PLACE_MAX_IMAGES=3
RICH_AUTO_PLACE_MIN_SCORE=0.25

# Application metadata
APP_NAME="Sample Chatbot"
APP_VERSION=1.0
APP_DESCRIPTION="A sample chatbot application with FastAPI and PostgreSQL"

# Brave Image Search
BRAVE_SEARCH_API_KEY=
BRAVE_IMAGE_SEARCH_DEFAULT_COUNT=6
BRAVE_IMAGE_SEARCH_MAX_COUNT=10
BRAVE_IMAGE_SEARCH_TIMEOUT_SECONDS=2.5
BRAVE_IMAGE_SEARCH_DEFAULT_SAFESEARCH=strict
