# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/chatbot

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Environment
ENVIRONMENT=development

# Security
SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# LLM API Keys
GEMINI_API_KEY="your_gemini_api"

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents

# Redis Configuration (for Celery)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Celery Worker Configuration
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# File Storage Configuration
TEMP_STORAGE_PATH=app/temp
MAX_FILE_SIZE_MB=50

# Document Processing Configuration
ALLOWED_FILE_EXTENSIONS=[".txt",".pdf",".docx"]
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200
DOCUMENT_PROCESSING_TIMEOUT=300

# RAG Retrieval Configuration
# Number of chunks to retrieve from vector database
RAG_TOP_K=15
# Minimum similarity score for retrieval
RAG_SCORE_THRESHOLD=0.2
# Maximum tokens to include in RAG context
RAG_MAX_CONTEXT_TOKENS=30000

# Re-ranking Configuration
# Enable re-ranking of retrieved chunks for better relevance
ENABLE_RERANKING=true
# Re-ranker model name
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Number of chunks to keep after re-ranking
RERANK_TOP_K=10

# Advanced Chunking Configuration
# Chunk by complete sentences instead of arbitrary splits
CHUNK_BY_SENTENCES=true
# Preserve context across PDF pages
PRESERVE_CROSS_PAGE_CONTEXT=true

# RAG Prompt Configuration
# Maximum number of chunks to include in prompt, 0 = all retrieved chunks
RAG_CHUNKS_IN_PROMPT=10
# Maximum characters per chunk in prompt, 0 = no limit0)
MAX_CHUNK_CHARS_IN_PROMPT=2000

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5
ENABLE_HEALTH_CHECKS=true